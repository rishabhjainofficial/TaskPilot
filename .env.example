# Environment Configuration for TaskPilot SaaS

# App
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL 16 with pgvector & RLS)
DATABASE_URL=postgresql+asyncpg://taskpilot:taskpilot_dev@localhost:5432/taskpilot

# Redis (Sessions, Rate limiting, ARQ jobs)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=taskpilot-uploads
S3_REGION=us-east-1

# Authentication (Argon2id + JWT)
JWT_SECRET=dev-secret-change-in-production-super-secure-key-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Keys
OPENAI_API_KEY=
GROQ_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
