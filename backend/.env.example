# Free LLM API Configuration (Groq / Grok)
# Get a free key at https://console.groq.com (starts with gsk_)
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Alternatively, for xAI Grok (console.x.ai):
# GROK_API_KEY=xai-...
# LLM_MODEL=grok-2-latest
# LLM_BASE_URL=https://api.x.ai/v1

# SQLite Database (Default - no setup required)
DATABASE_URL=sqlite:///./taskbot.db
